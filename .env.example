# Public root URL of the Waline server (not the Vercel dashboard URL).
# This project's currently detected production domain is shown below.
PUBLIC_WALINE_SERVER_URL=https://waline-zmr2010s-projects.vercel.app

# Local-only password used by `pnpm private-zone:encrypt`.
# Do not prefix it with PUBLIC_ and do not configure it on the deployment platform.
PRIVATE_ZONE_PASSWORD=replace-with-a-strong-private-password
