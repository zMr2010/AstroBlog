<script>
	const AUTH_STORAGE_KEY = "private-zone-decryption-key-v4";
	const LEGACY_AUTH_STORAGE_KEYS = [
		"private-zone-authenticated-v3",
		"private-zone-authenticated-v2",
		"private-zone-auth-expires-at",
	];
	type GalleryItem = {
		src: string;
		date: string;
		alt: string;
		hoverCaption: string;
		clickCaption: string;
		ratio?: number;
	};
	type MusicTrack = { src: string; title: string; artist: string };
	type PrivateZoneContent = {
		intro: string;
		gallery: GalleryItem[];
		music: MusicTrack[];
	};
	type EncryptedPayload = {
		version: number;
		iterations: number;
		salt: string;
		iv: string;
		ciphertext: string;
	};
	type RuntimeWindow = Window & { __privateZoneRuntimeInstalled?: boolean };

	let galleryObserver: ResizeObserver | undefined;
	let layoutFrame = 0;

	function base64Bytes(value: string): ArrayBuffer {
		return Uint8Array.from(atob(value), (character) => character.charCodeAt(0)).buffer as ArrayBuffer;
	}

	function hexBytes(value: string): ArrayBuffer {
		if (!/^[a-f0-9]{64}$/i.test(value)) throw new Error("Invalid stored key");
		return Uint8Array.from(value.match(/.{2}/g) ?? [], (byte) => Number.parseInt(byte, 16)).buffer as ArrayBuffer;
	}

	function bytesHex(value: ArrayBuffer): string {
		return Array.from(new Uint8Array(value), (byte) => byte.toString(16).padStart(2, "0")).join("");
	}

	async function passwordMaterial(password: string): Promise<ArrayBuffer> {
		return crypto.subtle.digest("SHA-256", new TextEncoder().encode(password));
	}

	async function decryptPayload(payload: EncryptedPayload, material: ArrayBuffer): Promise<PrivateZoneContent> {
		if (payload.version !== 1) throw new Error("Unsupported encrypted payload");
		const baseKey = await crypto.subtle.importKey("raw", material, "PBKDF2", false, ["deriveKey"]);
		const key = await crypto.subtle.deriveKey(
			{
				name: "PBKDF2",
				hash: "SHA-256",
				salt: base64Bytes(payload.salt),
				iterations: payload.iterations,
			},
			baseKey,
			{ name: "AES-GCM", length: 256 },
			false,
			["decrypt"],
		);
		const plaintext = await crypto.subtle.decrypt(
			{ name: "AES-GCM", iv: base64Bytes(payload.iv), tagLength: 128 },
			key,
			base64Bytes(payload.ciphertext),
		);
		return JSON.parse(new TextDecoder().decode(plaintext)) as PrivateZoneContent;
	}

	function storedMaterial(): ArrayBuffer | undefined {
		try {
			const value = localStorage.getItem(AUTH_STORAGE_KEY);
			return value ? hexBytes(value) : undefined;
		} catch {
			return undefined;
		}
	}

	function storeMaterial(material: ArrayBuffer): void {
		try {
			localStorage.setItem(AUTH_STORAGE_KEY, bytesHex(material));
			for (const key of LEGACY_AUTH_STORAGE_KEYS) {
				localStorage.removeItem(key);
				sessionStorage.removeItem(key);
			}
		} catch {
			// The current page still unlocks if persistent storage is unavailable.
		}
	}

	function clearStoredMaterial(): void {
		try {
			localStorage.removeItem(AUTH_STORAGE_KEY);
		} catch {
			// Ignore unavailable storage.
		}
	}

	function element<K extends keyof HTMLElementTagNameMap>(
		tag: K,
		className?: string,
	): HTMLElementTagNameMap[K] {
		const node = document.createElement(tag);
		if (className) node.className = className;
		return node;
	}

	function renderPrivateContent(root: HTMLElement, data: PrivateZoneContent): void {
		const content = root.querySelector<HTMLElement>("[data-pz-content]");
		if (!content) throw new Error("Private Zone content container is missing");
		content.replaceChildren();

		const introCard = element("div", "card-base pz-intro-card");
		const intro = element("p");
		intro.textContent = data.intro;
		introCard.append(intro);
		content.append(introCard);

		if (data.gallery.length > 0) {
			const gallery = element("div", "pz-gallery");
			gallery.dataset.pzGallery = "";
			gallery.ariaLabel = "Private Zone 图片";
			for (const item of data.gallery) {
				const article = element("article", "pz-gallery-item");
				if (item.ratio) article.dataset.ratio = String(item.ratio);
				const button = element("button", "pz-image-button");
				button.type = "button";
				button.dataset.clickSrc = item.src;
				button.dataset.clickCaption = item.clickCaption;
				button.dataset.clickTitle = item.alt;
				button.ariaLabel = `放大查看图片：${item.alt}`;
				const image = element("img");
				image.src = item.src;
				image.alt = item.alt;
				image.loading = "lazy";
				image.decoding = "async";
				button.append(image);
				if (item.hoverCaption) {
					const hover = element("span", "pz-hover-caption");
					hover.textContent = item.hoverCaption;
					button.append(hover);
				}
				if (item.date) {
					const time = element("time");
					time.dateTime = item.date;
					time.textContent = item.date;
					button.append(time);
				}
				article.append(button);
				gallery.append(article);
			}
			content.append(gallery);
		} else {
			const empty = element("div", "pz-empty card-base");
			const message = element("p");
			message.textContent = "还没有照片。请在 Private Zone 内容配置中添加图片。";
			empty.append(message);
			content.append(empty);
		}

		const dialog = element("dialog", "pz-caption-dialog");
		dialog.dataset.pzDialog = "";
		dialog.setAttribute("aria-labelledby", "pz-caption-title");
		const header = element("div", "pz-dialog-header");
		const title = element("h2");
		title.id = "pz-caption-title";
		title.dataset.pzDialogTitle = "";
		title.textContent = "照片文案";
		const close = element("button");
		close.type = "button";
		close.dataset.pzDialogClose = "";
		close.ariaLabel = "关闭文案弹窗";
		close.textContent = "×";
		header.append(title, close);
		const figure = element("figure", "pz-dialog-figure");
		const dialogImage = element("img");
		dialogImage.dataset.pzDialogImage = "";
		const caption = element("figcaption");
		caption.dataset.pzDialogCaption = "";
		figure.append(dialogImage, caption);
		dialog.append(header, figure);
		content.append(dialog);
	}

	function layoutGallery(gallery: HTMLElement): void {
		const items = Array.from(gallery.querySelectorAll<HTMLElement>(".pz-gallery-item"));
		gallery.replaceChildren(...items);
		if (items.length === 0 || gallery.clientWidth < 1) return;
		const gap = window.innerWidth < 640 ? 8 : 12;
		const availableWidth = gallery.clientWidth;
		const targetHeight = Math.min(230, Math.max(145, availableWidth * 0.24));
		const ratios = items.map((item) => {
			const image = item.querySelector<HTMLImageElement>("img");
			const naturalRatio = image?.naturalWidth && image?.naturalHeight
				? image.naturalWidth / image.naturalHeight
				: Number(item.dataset.ratio) || 4 / 3;
			return Math.min(8, Math.max(0.15, naturalRatio));
		});
		let start = 0;
		while (start < items.length) {
			let end = start;
			let ratioSum = 0;
			let idealHeight = targetHeight;
			while (end < items.length) {
				ratioSum += ratios[end];
				end += 1;
				idealHeight = (availableWidth - gap * (end - start - 1)) / ratioSum;
				if (idealHeight <= targetHeight) break;
			}
			const isLastRow = end === items.length;
			const rowHeight = isLastRow && idealHeight > targetHeight ? targetHeight : Math.max(1, idealHeight);
			const row = element("div", "pz-gallery-row");
			row.style.gap = `${gap}px`;
			for (let index = start; index < end; index += 1) {
				const item = items[index];
				item.style.width = `${ratios[index] * rowHeight}px`;
				item.style.height = `${rowHeight}px`;
				row.append(item);
			}
			gallery.append(row);
			start = end;
		}
	}

	function scheduleGalleryLayout(gallery: HTMLElement): void {
		cancelAnimationFrame(layoutFrame);
		layoutFrame = requestAnimationFrame(() => layoutGallery(gallery));
	}

	function setupGallery(gallery: HTMLElement): void {
		for (const image of gallery.querySelectorAll<HTMLImageElement>("img")) {
			image.addEventListener("load", () => scheduleGalleryLayout(gallery));
			image.addEventListener("error", () => scheduleGalleryLayout(gallery));
		}
		galleryObserver?.disconnect();
		galleryObserver = new ResizeObserver(() => scheduleGalleryLayout(gallery));
		galleryObserver.observe(gallery);
		scheduleGalleryLayout(gallery);
	}

	async function cachePrivateZoneAssets(root: HTMLElement, tracks: MusicTrack[]): Promise<void> {
		if (!("serviceWorker" in navigator)) return;
		const sources = [
			...Array.from(root.querySelectorAll<HTMLImageElement>("img"), (image) => image.src),
			...tracks.map((track) => track.src),
		];
		const urls = Array.from(new Set(sources))
			.map((source) => new URL(source, window.location.href))
			.filter((assetUrl) => assetUrl.origin === window.location.origin)
			.map((assetUrl) => assetUrl.href);
		if (urls.length === 0) return;
		try {
			const base = import.meta.env.BASE_URL;
			await navigator.serviceWorker.register(`${base}private-zone-sw.js`, { scope: base });
			const registration = await navigator.serviceWorker.ready;
			registration.active?.postMessage({ type: "CACHE_PRIVATE_ZONE_ASSETS", urls });
		} catch (error) {
			console.warn("Private Zone media caching is unavailable.", error);
		}
	}

	function setupDialog(root: HTMLElement): void {
		const dialog = root.querySelector<HTMLDialogElement>("[data-pz-dialog]");
		const title = dialog?.querySelector<HTMLElement>("[data-pz-dialog-title]");
		const dialogImage = dialog?.querySelector<HTMLImageElement>("[data-pz-dialog-image]");
		const caption = dialog?.querySelector<HTMLElement>("[data-pz-dialog-caption]");
		if (!dialog || !title || !dialogImage || !caption) return;
		root.addEventListener("click", (event) => {
			const target = event.target as HTMLElement;
			const imageButton = target.closest<HTMLElement>("[data-click-src]");
			if (imageButton) {
				const imageSrc = imageButton.dataset.clickSrc || "";
				const imageTitle = imageButton.dataset.clickTitle || "Private Zone photo";
				if (!imageSrc) return;
				title.textContent = imageTitle;
				dialogImage.src = imageSrc;
				dialogImage.alt = imageTitle;
				caption.textContent = imageButton.dataset.clickCaption || "";
				caption.hidden = !caption.textContent;
				dialog.showModal();
			}
			if (target.closest("[data-pz-dialog-close]")) dialog.close();
		});
		dialog.addEventListener("close", () => {
			dialogImage.removeAttribute("src");
			caption.textContent = "";
		});
		dialog.addEventListener("click", (event) => {
			if (event.target !== dialog) return;
			const rect = dialog.getBoundingClientRect();
			const inside = event.clientX >= rect.left && event.clientX <= rect.right
				&& event.clientY >= rect.top && event.clientY <= rect.bottom;
			if (!inside) dialog.close();
		});
	}

	function unlock(root: HTMLElement, data: PrivateZoneContent): void {
		renderPrivateContent(root, data);
		setupDialog(root);
		root.dataset.unlocked = "true";
		root.querySelector<HTMLElement>("[data-pz-gate]")?.setAttribute("aria-hidden", "true");
		const content = root.querySelector<HTMLElement>("[data-pz-content]");
		content?.removeAttribute("inert");
		content?.setAttribute("aria-hidden", "false");
		document.body.classList.add("private-zone-unlocked");
		const gallery = root.querySelector<HTMLElement>("[data-pz-gallery]");
		if (gallery) requestAnimationFrame(() => setupGallery(gallery));
		document.dispatchEvent(new CustomEvent("private-zone:unlocked", { detail: { tracks: data.music } }));
		void cachePrivateZoneAssets(root, data.music);
	}

	function readPayload(root: HTMLElement): EncryptedPayload {
		const node = root.querySelector<HTMLScriptElement>("[data-pz-payload]");
		if (!node?.textContent) throw new Error("Encrypted payload is missing");
		return JSON.parse(node.textContent) as EncryptedPayload;
	}

	function initPrivateZone(): void {
		const root = document.querySelector<HTMLElement>("[data-private-zone]");
		if (!root) {
			document.body.classList.remove("private-zone-unlocked");
			galleryObserver?.disconnect();
			return;
		}
		if (root.dataset.runtimeReady === "true") return;
		document.body.classList.remove("private-zone-unlocked");
		root.dataset.runtimeReady = "true";
		const form = root.querySelector<HTMLFormElement>("[data-pz-password-form]");
		const input = form?.querySelector<HTMLInputElement>("[data-pz-password]");
		const status = form?.querySelector<HTMLElement>("[data-pz-password-status]");
		const payload = readPayload(root);
		const remembered = storedMaterial();
		if (remembered) {
			void decryptPayload(payload, remembered)
				.then((data) => unlock(root, data))
				.catch(() => {
					clearStoredMaterial();
					input?.focus({ preventScroll: true });
				});
		} else {
			input?.focus({ preventScroll: true });
		}
		form?.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (!input || !status) return;
			const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
			if (submit) submit.disabled = true;
			status.textContent = "Verifying…";
			try {
				const material = await passwordMaterial(input.value);
				const data = await decryptPayload(payload, material);
				storeMaterial(material);
				status.textContent = "";
				input.value = "";
				unlock(root, data);
			} catch {
				status.textContent = "Incorrect password. Please try again.";
				input.select();
			} finally {
				if (submit) submit.disabled = false;
			}
		});
	}

	function installRuntime(): void {
		const runtimeWindow = window as RuntimeWindow;
		if (runtimeWindow.__privateZoneRuntimeInstalled) {
			initPrivateZone();
			return;
		}
		runtimeWindow.__privateZoneRuntimeInstalled = true;
		initPrivateZone();
		const attachSwupHook = () => {
			window.swup?.hooks.on("page:view", () => requestAnimationFrame(initPrivateZone));
		};
		if (window.swup?.hooks) attachSwupHook();
		else document.addEventListener("swup:enable", attachSwupHook, { once: true });
	}

	installRuntime();
</script>
