---
import EncryptedMusicLibrary from "@components/EncryptedMusicLibrary.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import encryptedPayload from "../generated/music-zone-payload.json";
---

<MainGridLayout
	title="Music"
	description="加密的私人音乐收藏。"
	lang="zh_CN"
>
	<meta slot="head" name="robots" content="noindex, nofollow, noarchive" />
	<div data-pagefind-ignore>
		<EncryptedMusicLibrary payload={encryptedPayload} client:load />
	</div>
</MainGridLayout>
