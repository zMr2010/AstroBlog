---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { privateZoneConfig } from "../utils/private-zone";

const legacyPasswordHash = "0984e7d137408fbfe182f0f47e5b0a8a2328188243aff44a5dbaf3e42f6ba559";
const configuredPassword = process.env.PRIVATE_ZONE_PASSWORD;
const configuredHash = process.env.PRIVATE_ZONE_PASSWORD_HASH?.trim().toLowerCase();
const hexBytes = (value: string) =>
	Uint8Array.from(value.match(/.{2}/g) ?? [], (byte) => Number.parseInt(byte, 16));
const base64 = (value: ArrayBuffer) => {
	const bytes = new Uint8Array(value);
	let binary = "";
	for (const byte of bytes) binary += String.fromCharCode(byte);
	return btoa(binary);
};
const passwordHash = configuredPassword
	? await crypto.subtle.digest("SHA-256", new TextEncoder().encode(configuredPassword))
	: hexBytes(
		configuredHash && /^[a-f0-9]{64}$/.test(configuredHash)
			? configuredHash
			: legacyPasswordHash,
	).buffer as ArrayBuffer;
const salt = crypto.getRandomValues(new Uint8Array(16));
const iv = crypto.getRandomValues(new Uint8Array(12));
const iterations = 310_000;
const baseKey = await crypto.subtle.importKey("raw", passwordHash, "PBKDF2", false, ["deriveKey"]);
const key = await crypto.subtle.deriveKey(
	{ name: "PBKDF2", hash: "SHA-256", salt: salt.buffer as ArrayBuffer, iterations },
	baseKey,
	{ name: "AES-GCM", length: 256 },
	false,
	["encrypt"],
);
const encrypted = await crypto.subtle.encrypt(
	{ name: "AES-GCM", iv: iv.buffer as ArrayBuffer, tagLength: 128 },
	key,
	new TextEncoder().encode(JSON.stringify(privateZoneConfig)),
);
const encryptedPayload = JSON.stringify({
	version: 1,
	iterations,
	salt: base64(salt.buffer as ArrayBuffer),
	iv: base64(iv.buffer as ArrayBuffer),
	ciphertext: base64(encrypted),
});
---

<MainGridLayout title="Private Zone" description="Private Zone" lang="en">
	<meta slot="head" name="robots" content="noindex, nofollow, noarchive" />

	<section
		id="private-zone"
		class="pz-shell"
		data-private-zone
		data-unlocked="false"
		data-pagefind-ignore
	>
		<div class="pz-gate card-base" data-pz-gate lang="en">
			<div class="pz-lock-mark" aria-hidden="true">
				<Icon name="material-symbols:lock-outline" class="text-[2rem]"></Icon>
			</div>
			<h1>Private Zone</h1>
			<p>Enter the password to access this private space.</p>
			<form class="pz-password-form" data-pz-password-form>
				<label for="private-zone-password">Password</label>
				<div class="pz-password-row">
					<input
						id="private-zone-password"
						data-pz-password
						type="password"
						autocomplete="current-password"
						placeholder="Enter password"
						required
					/>
					<button type="submit">Enter</button>
				</div>
				<p class="pz-password-status" data-pz-password-status role="status" aria-live="polite"></p>
			</form>
		</div>

		<div class="pz-content" data-pz-content aria-hidden="true" inert lang="zh-CN"></div>
		<script is:inline type="application/octet-stream" data-pz-payload set:html={encryptedPayload}></script>
	</section>
</MainGridLayout>

<style is:global>
	.pz-shell {
		width: 100%;
		min-height: 24rem;
	}

	.pz-shell[data-unlocked="false"] .pz-content,
	.pz-shell[data-unlocked="true"] .pz-gate {
		display: none;
	}

	.pz-gate {
		display: flex;
		min-height: 28rem;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		padding: 2rem;
		text-align: center;
	}

	.pz-lock-mark {
		display: flex;
		width: 4rem;
		height: 4rem;
		align-items: center;
		justify-content: center;
		margin-bottom: 1rem;
		border-radius: 1.25rem;
		color: var(--primary);
		background: var(--btn-regular-bg);
	}

	.pz-gate h1 {
		color: rgb(0 0 0 / 0.85);
		font-size: 1.65rem;
		font-weight: 700;
	}

	:global(.dark) .pz-gate h1 {
		color: rgb(255 255 255 / 0.9);
	}

	.pz-gate > p {
		margin-top: 0.4rem;
		color: rgb(0 0 0 / 0.48);
	}

	:global(.dark) .pz-gate > p {
		color: rgb(255 255 255 / 0.48);
	}

	.pz-password-form {
		width: min(100%, 24rem);
		margin-top: 1.5rem;
		text-align: left;
	}

	.pz-password-form label {
		display: block;
		margin: 0 0 0.45rem 0.15rem;
		color: rgb(0 0 0 / 0.62);
		font-size: 0.8rem;
		font-weight: 700;
	}

	:global(.dark) .pz-password-form label {
		color: rgb(255 255 255 / 0.62);
	}

	.pz-password-row {
		display: flex;
		gap: 0.55rem;
	}

	.pz-password-row input {
		min-width: 0;
		flex: 1;
		border: 1px solid rgb(0 0 0 / 0.1);
		border-radius: 0.75rem;
		outline: none;
		padding: 0.7rem 0.9rem;
		color: rgb(0 0 0 / 0.8);
		background: var(--page-bg);
		transition: border-color 150ms ease, box-shadow 150ms ease;
	}

	:global(.dark) .pz-password-row input {
		border-color: rgb(255 255 255 / 0.1);
		color: rgb(255 255 255 / 0.82);
	}

	.pz-password-row input:focus {
		border-color: var(--primary);
		box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 18%, transparent);
	}

	.pz-password-row button {
		border-radius: 0.75rem;
		padding: 0.7rem 1.15rem;
		color: white;
		font-weight: 700;
		background: var(--primary);
		transition: filter 150ms ease, transform 150ms ease;
	}

	.pz-password-row button:hover {
		filter: brightness(1.04);
	}

	.pz-password-row button:active {
		transform: scale(0.96);
	}

	.pz-password-row button:disabled {
		opacity: 0.55;
	}

	.pz-password-status {
		min-height: 1.25rem;
		margin: 0.45rem 0.2rem 0;
		color: oklch(0.62 0.2 25);
		font-size: 0.78rem;
	}

	.pz-content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.pz-intro-card {
		padding: 1.25rem 1.5rem;
	}

	.pz-intro-card p {
		color: rgb(0 0 0 / 0.76);
		font-size: 1rem;
		font-weight: 600;
	}

	:global(.dark) .pz-intro-card p {
		color: rgb(255 255 255 / 0.78);
	}

	.pz-gallery {
		display: flex;
		width: 100%;
		flex-direction: column;
		gap: 0.75rem;
	}

	:global(.pz-gallery-row) {
		display: flex;
		width: 100%;
		align-items: flex-start;
		justify-content: flex-start;
	}

	.pz-gallery-item {
		position: relative;
		min-width: 0;
		flex: 0 0 auto;
		overflow: hidden;
		border-radius: 0.9rem;
		box-shadow: 0 0.2rem 0.8rem rgb(0 0 0 / 0.08);
		background: var(--card-bg);
	}

	.pz-image-button {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		overflow: hidden;
		text-align: left;
	}

	.pz-image-button {
		cursor: pointer;
	}

	.pz-image-button img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		background: rgb(0 0 0 / 0.035);
		transition: filter 220ms ease;
	}

	.pz-image-button:active img {
		filter: brightness(0.9);
	}

	.pz-hover-caption {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		color: white;
		font-size: clamp(0.78rem, 1.5vw, 1rem);
		line-height: 1.5;
		text-align: center;
		white-space: pre-wrap;
		opacity: 0;
		background: rgb(0 0 0 / 0.62);
		transition: opacity 180ms ease;
	}

	.pz-image-button:hover .pz-hover-caption,
	.pz-image-button:focus-visible .pz-hover-caption {
		opacity: 1;
	}

	.pz-image-button time {
		position: absolute;
		right: 0.55rem;
		bottom: 0.5rem;
		border-radius: 999px;
		padding: 0.22rem 0.55rem;
		color: white;
		font-size: 0.68rem;
		font-weight: 600;
		line-height: 1.2;
		background: rgb(0 0 0 / 0.54);
		backdrop-filter: blur(6px);
	}

	.pz-empty {
		display: flex;
		min-height: 13rem;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 0.75rem;
		padding: 2rem;
		color: rgb(0 0 0 / 0.42);
		text-align: center;
	}

	:global(.dark) .pz-empty {
		color: rgb(255 255 255 / 0.42);
	}

	.pz-empty p {
		max-width: 34rem;
	}

	.pz-empty code {
		border-radius: 0.3rem;
		padding: 0.12rem 0.3rem;
		color: var(--btn-content);
		background: var(--btn-regular-bg);
	}

	.pz-caption-dialog {
		width: min(56rem, calc(100vw - 2rem));
		max-height: min(88vh, 52rem);
		overflow: auto;
		border: 0;
		border-radius: 1rem;
		padding: 1.25rem;
		box-shadow: 0 1.25rem 4rem rgb(0 0 0 / 0.32);
		color: #171717;
		background: white;
	}

	.pz-caption-dialog::backdrop {
		background: rgb(0 0 0 / 0.62);
		backdrop-filter: blur(2px);
	}

	.pz-dialog-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.8rem;
		border-bottom: 1px solid rgb(0 0 0 / 0.09);
	}

	.pz-dialog-header h2 {
		font-size: 1.05rem;
		font-weight: 700;
	}

	.pz-dialog-header button {
		display: flex;
		width: 2.25rem;
		height: 2.25rem;
		align-items: center;
		justify-content: center;
		border-radius: 0.65rem;
		background: rgb(0 0 0 / 0.055);
	}

	.pz-dialog-figure {
		margin: 0;
		padding-top: 1rem;
	}

	.pz-dialog-figure img {
		display: block;
		width: 100%;
		max-height: min(68vh, 38rem);
		border-radius: 0.8rem;
		object-fit: contain;
		background: rgb(0 0 0 / 0.045);
	}

	.pz-dialog-figure figcaption {
		overflow-wrap: anywhere;
		padding-top: 1rem;
		line-height: 1.75;
		white-space: pre-wrap;
	}

	.pz-dialog-figure figcaption:empty {
		display: none;
	}

	@media (max-width: 639px) {
		.pz-gate {
			min-height: 24rem;
			padding: 1.4rem;
		}

		.pz-password-row {
			flex-direction: column;
		}

		.pz-password-row button {
			width: 100%;
		}

		.pz-gallery {
			gap: 0.5rem;
		}
	}

	@media (hover: none) {
		.pz-hover-caption {
			align-items: flex-end;
			justify-content: flex-start;
			padding: 2.5rem 0.75rem 0.65rem;
			font-size: 0.75rem;
			text-align: left;
			opacity: 1;
			background: linear-gradient(to top, rgb(0 0 0 / 0.7), transparent 72%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pz-hover-caption,
		.pz-image-button img {
			transition: none;
		}
	}
</style>
